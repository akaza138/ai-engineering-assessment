# Copy this file to .env and fill in your actual keys
# DO NOT commit your real .env file to version control

# ── LLM Provider Selection ───────────────────────────────────────
# Set LLM_PROVIDER to one of: "ollama", "groq", "openai", "anthropic", "xai"
LLM_PROVIDER=ollama

# ── Option 1: Ollama (Free, local — recommended for offline use) ──
# Run: ollama pull llama3  OR  ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ── Option 2: Groq (Free tier — fastest cloud option) ────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Option 3: OpenAI ──────────────────────────────────────────────
# Get a key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ── Option 4: Anthropic (Claude) ─────────────────────────────────
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Option 5: xAI (Grok) ─────────────────────────────────────────
# Get a key at: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# ── Embedding Model (always local, no API key needed) ────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
